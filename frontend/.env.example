# No credentials belong in VITE_* variables. They are public in the browser.
# Empty means same-origin /api/v1. Local Vite proxy forwards to this Go address.
VITE_API_BASE_URL=
API_PROXY_TARGET=http://127.0.0.1:8080
# Explicitly enable only capabilities supported by your Go server.
VITE_ENABLE_NVIDIA_REVIEW=false
VITE_ENABLE_OPENAI_EXPLANATION=false
VITE_DEMO_DATASET_ENDPOINT=
